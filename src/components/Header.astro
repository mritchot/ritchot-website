---
import { externalAttrs } from '../lib/rehype-external-links';

// Trailing slashes match the canonical form Base.astro and the sitemap emit:
// linking to the unslashed path made every page on the site link through a 301.
const nav = [
  { href: '/writing/', label: 'Writing' },
  { href: '/projects/', label: 'Projects' },
  { href: '/resume/', label: 'Resume' },
  { href: '/about/', label: 'About' },
];

// ScholaVal, the author's benchmark project on its own domain
const scholaval = 'https://scholaval.com/';

const path = Astro.url.pathname;
// Normalized so the comparisons hold whichever form `href` takes; without it a
// slashed href compares against a double slash and nested routes never match.
const isCurrent = (href: string) => {
  const base = href.replace(/\/$/, '');
  return path === base || path.startsWith(`${base}/`);
};
---

<header>
  <nav aria-label="Site">
    <a class="home" href="/">Michael Ritchot</a>
    <!-- one link, placed twice: beside the wordmark on narrow screens, after
         the pages on wide ones. display:none keeps one in the a11y tree. -->
    <a class="sv sv-narrow" href={scholaval} aria-label="ScholaVal" {...externalAttrs(scholaval)}>
      Schola<span class="dot">·</span>Val<span class="arrow" aria-hidden="true">↗</span>
    </a>
    <ul>
      {
        nav.map(({ href, label }) => (
          <li>
            <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
              {label}
            </a>
          </li>
        ))
      }
      <li class="rule" aria-hidden="true"></li>
      <li class="sv-wide">
        <a class="sv" href={scholaval} aria-label="ScholaVal" {...externalAttrs(scholaval)}>
          Schola<span class="dot">·</span>Val<span class="arrow" aria-hidden="true">↗</span>
        </a>
      </li>
      <li>
        <!-- D23 toggle: statically reserved (no layout shift), invisible
             until /theme.js wires it; with JS off it never appears. -->
        <button class="theme-toggle" type="button" aria-label="Theme">◐</button>
      </li>
    </ul>
  </nav>
</header>

<style>
  header {
    border-block-end: 1px solid var(--line);
  }

  nav {
    max-width: 52rem;
    margin-inline: auto;
    padding: 0.9rem 1.25rem;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: var(--text--1);
  }

  /* serif wordmark (D16 final) — sized ≈ nav cap-height × 1.4 */
  .home {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    color: var(--ink);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  ul {
    display: flex;
    align-items: baseline;
    gap: 1.1rem;
    list-style: none;
    padding: 0;
  }

  /* ScholaVal: its wordmark in mono capitals, set apart by a thin rule */
  /* nav-qualified so it outranks the ul a rules */
  nav .sv {
    color: var(--ink);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }

  nav .sv:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .sv .dot {
    color: var(--vermilion);
  }

  .sv .arrow {
    margin-inline-start: 0.25em;
    letter-spacing: 0;
    font-size: 0.85em;
    color: var(--ink-soft);
  }

  .rule {
    align-self: stretch;
    inline-size: 1px;
    background: var(--line);
  }

  .sv-narrow {
    display: none;
  }

  ul a {
    position: relative;
    color: var(--ink-soft);
    text-decoration: none;
  }

  ul a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  ul a[aria-current='page'] {
    color: var(--ink);
  }

  /* current page: small vermilion underline dot */
  ul a[aria-current='page']::after {
    content: '';
    position: absolute;
    inset-inline-start: 50%;
    transform: translateX(-50%);
    inset-block-end: -0.55em;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--vermilion);
  }

  /* narrower screens: wordmark and ScholaVal on one row, the pages on the
     row below (ruling, 14-07-2026, extended 19-11-2026 when the ScholaVal
     link made one row too wide below 760px) — no hamburger, no JS */
  @media (max-width: 760px) {
    nav {
      flex-wrap: wrap;
      gap: 0.55rem 1rem;
      padding-block: 0.8rem;
    }

    .sv-narrow {
      display: inline;
      margin-inline-start: auto;
    }

    .rule,
    .sv-wide {
      display: none;
    }

    ul {
      flex-basis: 100%;
    }
  }
</style>
